    },
    "revenueGrowth": {
      "label": "Revenue growth",
      "category": "growth",
      "unit": "percent",
      "direction": "higher_is_better",
      "description": "Revenue increase versus the prior comparable period.",
      "thresholds": {
        "exceptional": 80,
        "strong": 25,
        "solid": 10,
        "neutral": 0,
        "caution": -10,
        "weak": -30
      }
    },
    "grossMargin": {
      "label": "Gross margin",
      "category": "quality",
      "unit": "percent",
      "direction": "higher_is_better",
      "description": "Revenue retained after direct cost of goods sold.",
      "thresholds": {
        "exceptional": 75,
        "strong": 60,
        "solid": 50,
        "neutral": 40,
        "caution": 30,
        "weak": 20
      }
    },
    "operatingMargin": {
      "label": "Operating margin",
      "category": "quality",
      "unit": "percent",
      "direction": "higher_is_better",
      "description": "Operating profit as a percentage of revenue.",
      "thresholds": {
        "exceptional": 55,
        "strong": 40,
        "solid": 25,
        "neutral": 15,
        "caution": 5,
        "weak": 0
      }
    },
    "netMargin": {
      "label": "Net margin",
      "category": "quality",
      "unit": "percent",
      "direction": "higher_is_better",
      "description": "Net income as a percentage of revenue.",
      "thresholds": {
        "exceptional": 45,
        "strong": 30,
        "solid": 20,
        "neutral": 10,
        "caution": 3,
        "weak": 0
      }
    },
    "cashFlowOperations": {
